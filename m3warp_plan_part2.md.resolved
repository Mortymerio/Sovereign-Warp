# 🚀 M3Warp — Plan de Implementación (Parte 2: Frontend React + Monaco)

---

## 🎨 FASE 5: Frontend — Componentes React

### 5.1 `frontend/src/store.ts` — Zustand Store

```typescript
import { create } from 'zustand';

interface OpenTab {
  path: string;
  name: string;
  language: string;
  isDirty: boolean;
  totalLines: number;
  fileSize: number;
}

interface SearchResult {
  filePath: string;
  line: number;
  column: number;
  preview: string;
  match: string;
}

interface FileNode {
  name: string;
  path: string;
  isDir: boolean;
  size: number;
  children?: FileNode[];
  language?: string;
}

interface AppState {
  // Workspace
  rootPath: string | null;
  fileTree: FileNode | null;
  
  // Tabs
  openTabs: OpenTab[];
  activeTabPath: string | null;
  
  // Editor
  cursorLine: number;
  cursorCol: number;
  
  // Search
  searchQuery: string;
  searchResults: SearchResult[];
  isSearching: boolean;
  
  // UI
  theme: string;
  isSidebarOpen: boolean;
  isSearchPanelOpen: boolean;
  isCommandPaletteOpen: boolean;
  sidebarWidth: number;
  fontSize: number;
  
  // Actions
  setRootPath: (path: string) => void;
  setFileTree: (tree: FileNode) => void;
  openFile: (path: string, name: string, lang: string, totalLines: number, size: number) => void;
  closeTab: (path: string) => void;
  setActiveTab: (path: string) => void;
  markDirty: (path: string, dirty: boolean) => void;
  setCursor: (line: number, col: number) => void;
  setSearchQuery: (q: string) => void;
  setSearchResults: (r: SearchResult[]) => void;
  setTheme: (t: string) => void;
  toggleSidebar: () => void;
  toggleSearchPanel: () => void;
  toggleCommandPalette: () => void;
  setFontSize: (s: number) => void;
}

export const useStore = create<AppState>((set, get) => ({
  rootPath: null,
  fileTree: null,
  openTabs: [],
  activeTabPath: null,
  cursorLine: 1,
  cursorCol: 1,
  searchQuery: '',
  searchResults: [],
  isSearching: false,
  theme: localStorage.getItem('m3warp-theme') || 'cyber-ronin',
  isSidebarOpen: true,
  isSearchPanelOpen: false,
  isCommandPaletteOpen: false,
  sidebarWidth: 260,
  fontSize: parseInt(localStorage.getItem('m3warp-fontSize') || '14'),

  setRootPath: (path) => set({ rootPath: path }),
  setFileTree: (tree) => set({ fileTree: tree }),

  openFile: (path, name, lang, totalLines, size) => {
    const { openTabs } = get();
    const exists = openTabs.find(t => t.path === path);
    if (!exists) {
      set({ 
        openTabs: [...openTabs, { path, name, language: lang, isDirty: false, totalLines, fileSize: size }],
        activeTabPath: path 
      });
    } else {
      set({ activeTabPath: path });
    }
  },

  closeTab: (path) => {
    const { openTabs, activeTabPath } = get();
    const filtered = openTabs.filter(t => t.path !== path);
    let newActive = activeTabPath;
    if (activeTabPath === path) {
      newActive = filtered.length > 0 ? filtered[filtered.length - 1].path : null;
    }
    set({ openTabs: filtered, activeTabPath: newActive });
  },

  setActiveTab: (path) => set({ activeTabPath: path }),
  markDirty: (path, dirty) => set(s => ({
    openTabs: s.openTabs.map(t => t.path === path ? { ...t, isDirty: dirty } : t)
  })),
  setCursor: (line, col) => set({ cursorLine: line, cursorCol: col }),
  setSearchQuery: (q) => set({ searchQuery: q }),
  setSearchResults: (r) => set({ searchResults: r, isSearching: false }),
  setTheme: (t) => { localStorage.setItem('m3warp-theme', t); set({ theme: t }); },
  toggleSidebar: () => set(s => ({ isSidebarOpen: !s.isSidebarOpen })),
  toggleSearchPanel: () => set(s => ({ isSearchPanelOpen: !s.isSearchPanelOpen })),
  toggleCommandPalette: () => set(s => ({ isCommandPaletteOpen: !s.isCommandPaletteOpen })),
  setFontSize: (s) => { localStorage.setItem('m3warp-fontSize', String(s)); set({ fontSize: s }); },
}));
```

