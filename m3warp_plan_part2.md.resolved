### 5.3 `FileExplorer.tsx` — Árbol Lazy-Load

```tsx
import { useState, useEffect } from 'react';
import { ChevronRight, ChevronDown, File, Folder, FolderOpen } from 'lucide-react';
import { useStore } from '../store';
import { FilesystemService, EditorService } from '../../wailsjs/go/services';

interface FileNode {
  name: string; path: string; isDir: boolean;
  size: number; children?: FileNode[]; language?: string;
}

function TreeNode({ node, depth = 0 }: { node: FileNode; depth?: number }) {
  const [expanded, setExpanded] = useState(depth < 1);
  const [children, setChildren] = useState<FileNode[]>(node.children || []);
  const activeTabPath = useStore(s => s.activeTabPath);
  const openFile = useStore(s => s.openFile);

  const handleExpand = async () => {
    if (!node.isDir) return;
    if (!expanded && children.length === 0) {
      // Lazy load
      const result = await FilesystemService.ExpandDirectory(node.path);
      setChildren(result);
    }
    setExpanded(!expanded);
  };

  const handleClick = async () => {
    if (node.isDir) {
      handleExpand();
    } else {
      const meta = await EditorService.OpenFile(node.path);
      openFile(meta.path, node.name, meta.language, meta.totalLines, meta.size);
    }
  };

  const isActive = activeTabPath === node.path;

  return (
    <div>
      <div
        onClick={handleClick}
        className={`flex items-center gap-1.5 px-2 py-[5px] cursor-pointer text-[13px]
          transition-all duration-150 select-none group
          ${isActive ? 'bg-blue-500/15 text-blue-400' : 'hover:bg-white/5 text-[var(--sidebar-text)]'}
        `}
        style={{ paddingLeft: `${depth * 16 + 8}px` }}
      >
        {node.isDir ? (
          <>
            {expanded ? <ChevronDown size={14} className="opacity-50" /> : <ChevronRight size={14} className="opacity-50" />}
            {expanded ? <FolderOpen size={15} className="text-amber-400" /> : <Folder size={15} className="text-amber-400/70" />}
          </>
        ) : (
          <>
            <span className="w-[14px]" />
            <File size={14} className="opacity-40" />
          </>
        )}
        <span className="truncate font-medium">{node.name}</span>
        {!node.isDir && (
          <span className="ml-auto text-[10px] opacity-20 group-hover:opacity-40">
            {formatSize(node.size)}
          </span>
        )}
      </div>
      {expanded && children.map(child => (
        <TreeNode key={child.path} node={child} depth={depth + 1} />
      ))}
    </div>
  );
}

function formatSize(bytes: number): string {
  if (bytes < 1024) return `${bytes}B`;
  if (bytes < 1048576) return `${(bytes/1024).toFixed(0)}K`;
  return `${(bytes/1048576).toFixed(1)}M`;
}

export default function FileExplorer() {
  const fileTree = useStore(s => s.fileTree);
  const setFileTree = useStore(s => s.setFileTree);
  const setRootPath = useStore(s => s.setRootPath);

  const handleOpenFolder = async () => {
    // Wails v3 tiene diálogo nativo
    const path = await (window as any).runtime.OpenDirectoryDialog({});
    if (path) {
      const tree = await FilesystemService.OpenFolder(path);
      setFileTree(tree);
      setRootPath(path);
    }
  };

  return (
    <div className="h-full flex flex-col bg-[var(--sidebar-bg)] text-[var(--sidebar-text)]">
      <div className="h-10 flex items-center justify-between px-3 border-b border-white/5 shrink-0">
        <span className="text-[10px] font-black uppercase tracking-[0.15em] opacity-50">
          Explorer
        </span>
        <button onClick={handleOpenFolder} className="text-[11px] opacity-50 hover:opacity-100 hover:text-blue-400 transition-all">
          Open
        </button>
      </div>
      <div className="flex-1 overflow-y-auto overflow-x-hidden py-1">
        {fileTree ? (
          <TreeNode node={fileTree} />
        ) : (
          <div className="flex flex-col items-center justify-center h-full gap-4 opacity-30">
            <Folder size={40} />
            <button onClick={handleOpenFolder} className="text-xs hover:text-blue-400 transition-colors">
              Open a Folder
            </button>
          </div>
        )}
      </div>
    </div>
  );
}
```

