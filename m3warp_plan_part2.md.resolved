### 5.2 `MonacoEditor.tsx` — Editor con Paginación Virtual

```tsx
import { useEffect, useRef, useCallback } from 'react';
import * as monaco from 'monaco-editor';
import { useStore } from '../store';

// Wails bindings auto-generados
import { EditorService } from '../../wailsjs/go/services';

const CHUNK_SIZE = 2000; // líneas por chunk

interface Props {
  filePath: string;
  language: string;
  totalLines: number;
}

export default function MonacoEditor({ filePath, language, totalLines }: Props) {
  const editorRef = useRef<monaco.editor.IStandaloneCodeEditor | null>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  const loadedRanges = useRef<Set<string>>(new Set());
  const fontSize = useStore(s => s.fontSize);
  const theme = useStore(s => s.theme);
  const setCursor = useStore(s => s.setCursor);
  const markDirty = useStore(s => s.markDirty);

  // Crear editor al montar
  useEffect(() => {
    if (!containerRef.current) return;

    const editor = monaco.editor.create(containerRef.current, {
      language,
      theme: theme.includes('light') ? 'vs' : 'vs-dark',
      fontSize,
      minimap: { enabled: true, scale: 2 },
      smoothScrolling: true,
      cursorBlinking: 'smooth',
      cursorSmoothCaretAnimation: 'on',
      renderWhitespace: 'selection',
      bracketPairColorization: { enabled: true },
      guides: { bracketPairs: true, indentation: true },
      padding: { top: 16 },
      lineNumbers: 'on',
      wordWrap: 'off',
      scrollBeyondLastLine: false,
      automaticLayout: true,
    });

    editorRef.current = editor;

    // Track cursor
    editor.onDidChangeCursorPosition((e) => {
      setCursor(e.position.lineNumber, e.position.column);
    });

    // Track dirty state
    editor.onDidChangeModelContent(() => {
      markDirty(filePath, true);
    });

    // Cargar chunk inicial
    loadChunk(1, CHUNK_SIZE);

    // Scroll listener para lazy loading
    editor.onDidScrollChange(debounce((e: monaco.IScrollEvent) => {
      if (!editorRef.current) return;
      const visibleRanges = editorRef.current.getVisibleRanges();
      if (visibleRanges.length === 0) return;

      const firstVisible = visibleRanges[0].startLineNumber;
      const lastVisible = visibleRanges[visibleRanges.length - 1].endLineNumber;

      // Precargar 500 líneas antes y después del viewport
      const bufferStart = Math.max(1, firstVisible - 500);
      const bufferEnd = Math.min(totalLines, lastVisible + 500);

      // Cargar chunks faltantes
      for (let start = bufferStart; start <= bufferEnd; start += CHUNK_SIZE) {
        const end = Math.min(start + CHUNK_SIZE - 1, totalLines);
        const key = `${start}-${end}`;
        if (!loadedRanges.current.has(key)) {
          loadChunk(start, end);
        }
      }
    }, 150));

    // Ctrl+S = Guardar
    editor.addAction({
      id: 'm3warp-save',
      label: 'Save File',
      keybindings: [monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS],
      run: async () => {
        const content = editor.getValue();
        await EditorService.SaveFile(filePath, content);
        markDirty(filePath, false);
      },
    });

    return () => {
      editor.dispose();
      EditorService.CloseFile(filePath);
    };
  }, [filePath]);

  const loadChunk = useCallback(async (from: number, to: number) => {
    const key = `${from}-${to}`;
    if (loadedRanges.current.has(key)) return;
    loadedRanges.current.add(key);

    try {
      const chunk = await EditorService.ReadLines(filePath, from, to);
      if (!editorRef.current) return;

      const model = editorRef.current.getModel();
      if (!model) return;

      if (model.getLineCount() <= 1 && model.getLineContent(1) === '') {
        // Primera carga
        model.setValue(chunk.lines.join('\n'));
      } else {
        // Append: insertar al final
        const lastLine = model.getLineCount();
        const lastCol = model.getLineMaxColumn(lastLine);
        model.applyEdits([{
          range: new monaco.Range(lastLine, lastCol, lastLine, lastCol),
          text: '\n' + chunk.lines.join('\n'),
        }]);
      }
    } catch (err) {
      console.error('Chunk load error:', err);
      loadedRanges.current.delete(key);
    }
  }, [filePath]);

  return (
    <div ref={containerRef} className="w-full h-full" />
  );
}

function debounce<T extends (...args: any[]) => void>(fn: T, ms: number) {
  let timer: ReturnType<typeof setTimeout>;
  return (...args: Parameters<T>) => {
    clearTimeout(timer);
    timer = setTimeout(() => fn(...args), ms);
  };
}
```

