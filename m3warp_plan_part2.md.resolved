### 5.4 `TabBar.tsx` — Pestañas de Archivos

```tsx
import { X, Circle } from 'lucide-react';
import { useStore } from '../store';

export default function TabBar() {
  const tabs = useStore(s => s.openTabs);
  const activeTab = useStore(s => s.activeTabPath);
  const setActiveTab = useStore(s => s.setActiveTab);
  const closeTab = useStore(s => s.closeTab);

  if (tabs.length === 0) return null;

  return (
    <div className="h-9 flex items-end bg-[var(--editor-bg)] border-b border-white/5 overflow-x-auto shrink-0">
      {tabs.map(tab => (
        <div
          key={tab.path}
          onClick={() => setActiveTab(tab.path)}
          className={`group flex items-center gap-2 px-4 h-[34px] text-[12px] cursor-pointer
            border-r border-white/5 transition-all duration-150 select-none max-w-[200px]
            ${activeTab === tab.path
              ? 'bg-[var(--editor-bg)] text-white border-t-2 border-t-blue-500'
              : 'bg-black/10 text-white/40 hover:text-white/70 border-t-2 border-t-transparent'
            }`}
        >
          {tab.isDirty && (
            <Circle size={8} className="fill-amber-400 text-amber-400 shrink-0" />
          )}
          <span className="truncate font-medium">{tab.name}</span>
          <button
            onClick={(e) => { e.stopPropagation(); closeTab(tab.path); }}
            className="opacity-0 group-hover:opacity-60 hover:!opacity-100 hover:text-red-400 transition-all shrink-0"
          >
            <X size={14} />
          </button>
        </div>
      ))}
    </div>
  );
}
```

