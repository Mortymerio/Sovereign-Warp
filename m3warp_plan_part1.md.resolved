## ⚙️ FASE 1: Inicialización del Proyecto Wails v3

### Paso 1.1: Crear proyecto

```bash
# Instalar Wails CLI
go install github.com/wailsapp/wails/v3/cmd/wails3@latest

# Crear proyecto con React + TS
wails3 init -n M3Warp -t react-ts

# Verificar
cd M3Warp && wails3 dev
```

### Paso 1.2: `main.go` — Entry Point con Services

```go
package main

import (
	"embed"
	"log"

	"github.com/wailsapp/wails/v3/pkg/application"

	"m3warp/services"
)

//go:embed frontend/dist
var assets embed.FS

func main() {
	app := application.New(application.Options{
		Name:        "M3Warp",
		Description: "High-Performance Code Editor",
		Assets: application.AssetOptions{
			FS: assets,
		},
		Services: []application.Service{
			application.NewService(services.NewFilesystemService()),
			application.NewService(services.NewEditorService()),
			application.NewService(services.NewSearchService()),
			application.NewService(services.NewSettingsService()),
		},
	})

	win := app.NewWebviewWindowWithOptions(application.WebviewWindowOptions{
		Title:     "M3Warp",
		Width:     1400,
		Height:    900,
		MinWidth:  800,
		MinHeight: 600,
		Frameless: true,
		Windows: application.WindowsWindow{
			Theme: application.SystemDefault,
		},
	})
	_ = win

	if err := app.Run(); err != nil {
		log.Fatal(err)
	}
}
```

